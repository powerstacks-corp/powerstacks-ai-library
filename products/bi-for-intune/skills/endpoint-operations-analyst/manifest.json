  "connectionRequirements": [
    "DAX query access to the BI for Intune semantic model",
    "Ability to run several queries per request",
    "Metadata query access (INFO functions) to read the approved data settings; optional, with a fallback when not permitted. Never read other parameters, and never ApiKey, AzureAD TenantID, AzureAD ClientID, AzureAD ClientSecret.",
    "Optional: read-only Power BI REST access to the dataset's refresh history (Microsoft requires Write permission on the dataset for this call). A fallback applies when unavailable."
  ],
  "optionalRequirements": [
    "Executive outputs (on request): Python 3.9 or later on the computer running the skill; the python-pptx package for presentations.",
    "Optional: saved answers (reused until the semantic model refreshes) need Python 3.9 or later; standard library only."
  ],
